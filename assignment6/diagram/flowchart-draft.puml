@startuml flowchart-draft
title Markdown Export — flowchart (draft)
skinparam handwritten true
skinparam monochrome true
skinparam shadowing false

start
:user picks "Markdown table";
:server finds the right exporter;
:write the header row;
:write the |---| separator;
repeat
  :write one data row;
repeat while (more rows?) is (yes) not (no)
:send the .md file back;
stop
@enduml
